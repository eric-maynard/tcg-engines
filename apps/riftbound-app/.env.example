# Riftbound App — environment variables (Slice 8)
#
# Copy to .env for local production-mode testing:
#   cp .env.example .env
#   docker compose up --build
#
# In production (Fly.io / Railway / etc.) set these as platform secrets.

# Server
PORT=3000
NODE_ENV=production

# Database — SQLite path relative to apps/riftbound-app/
DATABASE_URL=sqlite://./data/riftbound.db

# Auth — used to sign session cookies. MUST be a long random string in
# production. Generate with: openssl rand -hex 32
COOKIE_SECRET=replace-me-with-openssl-rand-hex-32

# Session timeout in seconds (default 24h).
SESSION_TIMEOUT=86400

# Optional: app version string surfaced by GET /health. CI sets this
# from the commit SHA.
RIFTBOUND_VERSION=0.1.0

# Optional: pin a custom port via the legacy var (PORT takes priority).
# RIFTBOUND_PORT=3000

# Optional: swap auth backend to the dedicated auth-service. See the
# "Known blockers — auth-service local boot" section in README.md.
# AUTH_BACKEND=service
# AUTH_SERVICE_URL=http://localhost:3001
